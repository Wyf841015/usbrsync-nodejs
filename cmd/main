#!/bin/bash
### USB Rsync Node.js lifecycle script (aligned with fnclearup/fnm3u8dl)
### - set -euo pipefail for strict error handling
### - use lsof + pkill (not fuser — psmisc may be missing)
### - exec node so PID in PID_FILE is the actual node process
set -euo pipefail

TRIM_PKGVAR="${TRIM_PKGVAR:-/tmp/usbrsync}"
TRIM_APPDEST="${TRIM_APPDEST:-/vol3/@appcenter/usbrsync}"
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
# socket 必须留在 /var/apps/usbrsync/target/ (fnOS 网关只认 target/<app>.sock)
SOCK_NAME="usbrsync.sock"
SOCK_PATH="${TRIM_APPDEST}/target/${SOCK_NAME}"

export TRM_PKGVAR="${TRIM_PKGVAR}"
export PATH=/var/apps/nodejs_v24/target/bin:$PATH
CMD="node ${TRIM_APPDEST}/ui/server.js"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# Clean unresponsive node processes & stale socket
cleanup() {
    if command -v lsof >/dev/null 2>&1; then
        local pids
        pids=$(lsof -t "$(readlink -f "${SOCK_PATH}" 2>/dev/null || echo "${SOCK_PATH}")" 2>/dev/null || true)
        [ -n "${pids}" ] && kill -TERM ${pids} 2>/dev/null || true
        sleep 0.5
        pids=$(lsof -t "$(readlink -f "${SOCK_PATH}" 2>/dev/null || echo "${SOCK_PATH}")" 2>/dev/null || true)
        [ -n "${pids}" ] && kill -KILL ${pids} 2>/dev/null || true
    else
        pkill -TERM -f "node.*usbrsync.*server\.js" 2>/dev/null || true
        sleep 0.5
        pkill -KILL -f "node.*usbrsync.*server\.js" 2>/dev/null || true
    fi
    # Clean stale socket
    if [ -S "${SOCK_PATH}" ]; then
        rm -f "${SOCK_PATH}" 2>/dev/null || true
    fi
}

start_process() {
    if status; then
        return 0
    fi
    log_msg "Starting process ..."
    cleanup
    sleep 0.3
    # exec node so PID recorded is the actual node process, not a shell wrapper
    bash -c "exec ${CMD}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "pid=${pid}"
    # 启动后校验 node 真正存活
    sleep 1
    if ! status; then
        log_msg "startup failed - node exited"
        return 1
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "send TERM to PID:${pid}"
            kill -TERM "${pid}" 2>/dev/null || true
            local count=0
            while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 10 ]; do
                sleep 1; count=$((count + 1))
                log_msg "waiting ... (${count}s)"
            done
            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "send KILL to PID:${pid}"
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    cleanup
    return 0
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case "${1:-}" in
start)   start_process ;;
stop)    stop_process ;;
status)  if status; then exit 0; else exit 3; fi ;;
*)       echo "Usage: $0 {start|stop|status}" >&2; exit 1 ;;
esac